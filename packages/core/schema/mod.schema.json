{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Short, human-readable name"
    },
    "description": {
      "type": "string",
      "maxLength": 500,
      "description": "One or two sentences on what the mod changes"
    },
    "matches": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "description": "Chrome match pattern, e.g. \"https://example.com/*\""
      },
      "description": "Pages the mod runs on"
    },
    "css": {
      "description": "CSS to inject",
      "type": "string"
    },
    "js": {
      "description": "JavaScript run in an isolated user-script world",
      "type": "string"
    },
    "runAt": {
      "type": "string",
      "enum": ["document_start", "document_end", "document_idle"]
    },
    "checks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "selector": {
            "type": "string",
            "minLength": 1,
            "description": "CSS selector that must match on a healthy page"
          },
          "expect": {
            "type": "string",
            "const": "exists"
          }
        },
        "required": ["selector", "expect"],
        "additionalProperties": false
      },
      "description": "Selectors the mod depends on"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "createdBy": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["provider", "model"],
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "history": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "description": "Short, human-readable name"
          },
          "description": {
            "type": "string",
            "maxLength": 500,
            "description": "One or two sentences on what the mod changes"
          },
          "matches": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "description": "Chrome match pattern, e.g. \"https://example.com/*\""
            },
            "description": "Pages the mod runs on"
          },
          "css": {
            "description": "CSS to inject",
            "type": "string"
          },
          "js": {
            "description": "JavaScript run in an isolated user-script world",
            "type": "string"
          },
          "runAt": {
            "type": "string",
            "enum": ["document_start", "document_end", "document_idle"]
          },
          "checks": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "selector": {
                  "type": "string",
                  "minLength": 1,
                  "description": "CSS selector that must match on a healthy page"
                },
                "expect": {
                  "type": "string",
                  "const": "exists"
                }
              },
              "required": ["selector", "expect"],
              "additionalProperties": false
            },
            "description": "Selectors the mod depends on"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "createdBy": {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              },
              "model": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["provider", "model"],
            "additionalProperties": false
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "name",
          "description",
          "matches",
          "runAt",
          "checks",
          "version",
          "createdBy",
          "updatedAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "description",
    "matches",
    "runAt",
    "checks",
    "version",
    "createdBy",
    "createdAt",
    "updatedAt",
    "history"
  ],
  "additionalProperties": false
}
