{
  "name": "@claymod/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure TypeScript core for Claymod: mod schema, prompts, providers, validation, health.",
  "exports": {
    ".": "./src/index.ts",
    "./schema/mod.schema.json": "./schema/mod.schema.json",
    "./schema/mod-draft.schema.json": "./schema/mod-draft.schema.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "schema:export": "bun scripts/export-json-schema.ts"
  },
  "dependencies": {
    "@langchain/anthropic": "1.6.5",
    "@langchain/core": "1.4.1",
    "@langchain/langgraph": "1.7.5",
    "@langchain/openai": "1.8.4",
    "zod": "4.6.7"
  }
}
