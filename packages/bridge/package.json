{
  "name": "@claymod/bridge",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "claymod-bridge: native messaging host and MCP server for local agents.",
  "bin": {
    "claymod-bridge": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "bun build ./src/cli.ts --target=bun --outdir=dist",
    "compile": "bun scripts/compile.ts",
    "compile:all": "bun scripts/compile.ts --all"
  },
  "dependencies": {
    "@claymod/core": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  }
}
