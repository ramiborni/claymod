{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": [
    ".wxt/wxt.d.ts",
    "entrypoints",
    "lib",
    "tests",
    "wxt.config.ts",
    "playwright.config.ts",
    "scripts",
    "cypress.config.ts"
  ]
}
